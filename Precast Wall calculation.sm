          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">/</e>
        </contract>
        <result action="numeric">
          <e type="operand">8.4</e>
        </result>
      </math>
    </region>
    <region left="0" top="7308" width="344" height="50" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">UDL.3</e>
          <e type="operand">1.2</e>
