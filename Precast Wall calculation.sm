          <e type="operand" style="unit">mm</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="0" top="7191" width="572" height="32" border="true" color="#000000" fontSize="16" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-size: 16px;">1- Calculate ultimate design vertical load (per metre length)</p>
        </content>
      </text>
    </region>
    <region left="0" top="7236" width="380" height="50" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">UDL.1</e>
          <e type="operand">1.4</e>
          <e type="operand">DL.UNFACTORED</e>
          <e type="operator" args="2">*</e>
          <e type="operand">1.6</e>
          <e type="operand">LL.UNFACTORED</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">kN</e>
          <e type="operand" style="unit">m</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">/</e>
        </contract>
        <result action="numeric">
          <e type="operand">14.8</e>
        </result>
      </math>
    </region>
    <region left="0" top="7272" width="241" height="50" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">UDL.2</e>
          <e type="operand">1.4</e>
          <e type="operand">DL.UNFACTORED</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">kN</e>
