    </region>
    <region left="0" top="6795" width="330" height="41" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">0.3</e>
          <e type="operand">f.cu</e>
          <e type="operator" args="2">*</e>
          <e type="operand">t</e>
          <e type="operand">1.2</e>
          <e type="operand">e.x</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">-</e>
          <e type="operand">2</e>
          <e type="operand">e.a</e>
          <e type="operator" args="2">*</e>
