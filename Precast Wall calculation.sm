    </region>
    <region left="0" top="6840" width="224" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>150 mm thick plain wall is adequate</p>
        </content>
      </text>
