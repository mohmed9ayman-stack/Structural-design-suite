        <input>
          <e type="operand">CASE2</e>
        </input>
      </math>
    </region>
    <region left="0" top="7533" width="343" height="50" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">V.2</e>
          <e type="operand">UDL.1</e>
          <e type="operand">6</e>
          <e type="operand">2</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">*</e>
