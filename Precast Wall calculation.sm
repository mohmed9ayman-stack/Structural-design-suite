          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">/</e>
        </contract>
        <result action="numeric">
          <e type="operand">50.4</e>
        </result>
      </math>
    </region>
    <region left="360" top="7488" width="46" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">W</e>
          <e type="operand">0</e>
          <e type="operator" args="2">:</e>
