    </region>
    <region left="495" top="6975" width="144" height="50" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">DL.UNFACTORED</e>
          <e type="operand">6</e>
          <e type="operand" style="unit">kN</e>
          <e type="operand" style="unit">m</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">*</e>
