    <region left="0" top="6174" width="398" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>Case 1 : maximum floor load results in minimum load eccentricity</p>
        </content>
      </text>
    </region>
    <region left="0" top="6210" width="281" height="53" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">e.X</e>
          <e type="operand">t</e>
          <e type="operand">6</e>
          <e type="operator" args="2">/</e>
          <e type="operand">N.2max</e>
          <e type="operand">N.1max</e>
          <e type="operator" args="2">-</e>
          <e type="operand">N</e>
          <e type="operand">N.2max</e>
          <e type="operand">N.1max</e>
          <e type="operator" args="2">+</e>
          <e type="bracket">(</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">mm</e>
        </contract>
        <result action="numeric">
          <e type="operand">0.7775</e>
        </result>
      </math>
    </region>
    <region left="306" top="6219" width="130" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">0.7775</e>
          <e type="operand" style="unit">mm</e>
          <e type="operator" args="2">*</e>
          <e type="operand">20</e>
          <e type="operand" style="unit">mm</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">&lt;</e>
        </input>
      </math>
    </region>
    <region left="0" top="6264" width="81" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">e.x</e>
          <e type="operand">20</e>
          <e type="operand" style="unit">mm</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="0" top="6291" width="497" height="38" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>Case 2 : maximum load in span BC, minimum load in span AB, result in maximum<br />load eccentricity</p>
        </content>
      </text>
    </region>
    <region left="0" top="6336" width="273" height="53" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">e.X</e>
          <e type="operand">t</e>
          <e type="operand">6</e>
          <e type="operator" args="2">/</e>
          <e type="operand">N.2max</e>
          <e type="operand">N.1min</e>
          <e type="operator" args="2">-</e>
          <e type="operand">N</e>
          <e type="operand">N.2max</e>
          <e type="operand">N.1min</e>
          <e type="operator" args="2">+</e>
          <e type="bracket">(</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">mm</e>
        </contract>
        <result action="numeric">
          <e type="operand">1.513</e>
        </result>
      </math>
    </region>
    <region left="297" top="6354" width="122" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">1.513</e>
          <e type="operand" style="unit">mm</e>
          <e type="operator" args="2">*</e>
          <e type="operand">20</e>
          <e type="operand" style="unit">mm</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">&lt;</e>
        </input>
      </math>
    </region>
    <region left="0" top="6390" width="224" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>Eccentricity from slenderness effect</p>
        </content>
      </text>
    </region>
    <region left="126" top="6417" width="86" height="46" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">L.e</e>
          <e type="operand">t</e>
          <e type="operator" args="2">/</e>
        </input>
        <result action="numeric">
          <e type="operand">42.72</e>
        </result>
      </math>
    </region>
    <region left="0" top="6426" width="81" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">L.e</e>
          <e type="operand">3.6</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="270" top="6426" width="57" height="24" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">24</e>
          <e type="operand">15</e>
          <e type="operator" args="2">&gt;</e>
        </input>
      </math>
    </region>
    <region left="0" top="6462" width="490" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>Hence, additional eccentricity ea due to slenderness effect has to be considered.</p>
        </content>
      </text>
    </region>
    <region left="0" top="6480" width="175" height="55" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">e.a</e>
          <e type="operand">L.e</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operand">2500</e>
          <e type="operand">t</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">mm</e>
        </contract>
        <result action="numeric">
          <e type="operand">34.56</e>
        </result>
      </math>
    </region>
    <region left="0" top="6552" width="262" height="32" border="true" color="#000000" fontSize="16" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-size: 16px;">4- Total load eccentricities</p>
        </content>
      </text>
    </region>
    <region left="0" top="6588" width="569" height="38" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>Load eccentricity from floor is 20 mm for both cases 1 and 2. Hence the wall is designed using<br />the following loads and load eccentricities :</p>
        </content>
      </text>
    </region>
    <region left="0" top="6642" width="445" height="50" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">N.tot</e>
          <e type="operand">N</e>
          <e type="operand">N.2max</e>
          <e type="operator" args="2">+</e>
          <e type="operand">N.1max</e>
          <e type="operator" args="2">+</e>
          <e type="operand">0.15</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">*</e>
          <e type="operand">24</e>
          <e type="operator" args="2">*</e>
          <e type="operand" style="unit">kN</e>
          <e type="operand" style="unit">m</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">*</e>
          <e type="operand">1.8</e>
          <e type="operator" args="2">*</e>
          <e type="operand">1.4</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">kN</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">/</e>
        </contract>
        <result action="numeric">
          <e type="operand">580.112</e>
        </result>
      </math>
    </region>
    <region left="0" top="6696" width="322" height="32" border="true" color="#000000" fontSize="16" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-size: 16px;">5- Vertical load carrying capacity</p>
        </content>
      </text>
    </region>
    <region left="0" top="6732" width="199" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>For braced slender plain walls :</p>
        </content>
