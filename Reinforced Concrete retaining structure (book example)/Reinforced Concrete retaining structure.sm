    <region left="0" top="630" width="519" height="38" color="#000000" fontSize="10" isBreakable="false">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>Only that part of the embankment beyond the foundation footing is considered for the <br />verification of global stability to heave and sliding</p>
        </content>
      </text>
    </region>
    <region left="9" top="675" width="362" height="31" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">1.1</e>
