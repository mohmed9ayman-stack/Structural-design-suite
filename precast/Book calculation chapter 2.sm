    <region left="261" top="6390" width="146" height="50" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">f.cu.planks</e>
          <e type="operand">40</e>
          <e type="operand" style="unit">N</e>
          <e type="operand" style="unit">mm</e>
          <e type="operand">2</e>
