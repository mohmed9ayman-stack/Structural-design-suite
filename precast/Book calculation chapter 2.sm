    <region left="0" top="6435" width="299" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>The plank is to be designed as class 2 structure.</p>
        </content>
      </text>
    </region>
    <region left="0" top="6453" width="260" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>The method of construction is unpropped.</p>
        </content>
      </text>
    </region>
    <region left="0" top="6480" width="431" height="32" border="true" color="#000000" fontSize="16">
      <text lang="eng" width="427" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-size: 16px;">1- Calculate bending stresses at installation:</p>
        </content>
      </text>
    </region>
    <region left="9" top="6507" width="309" height="50" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">g.k</e>
          <e type="operand">0.08</e>
          <e type="operand">24</e>
          <e type="operator" args="2">*</e>
          <e type="operand" style="unit">kN</e>
          <e type="operand" style="unit">m</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">*</e>
          <e type="operand">0.065</e>
          <e type="operand">24</e>
          <e type="operator" args="2">*</e>
          <e type="operand" style="unit">kN</e>
          <e type="operand" style="unit">m</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">kN</e>
          <e type="operand" style="unit">m</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">/</e>
        </contract>
        <result action="numeric">
          <e type="operand">3.48</e>
        </result>
      </math>
    </region>
    <region left="9" top="6543" width="95" height="50" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">q.k</e>
          <e type="operand">1.5</e>
          <e type="operand" style="unit">kN</e>
          <e type="operand" style="unit">m</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="0" top="6597" width="136" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>Moment at mid-span</p>
        </content>
      </text>
    </region>
    <region left="270" top="6597" width="253" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>Top and soffit concrete stress in plank fc</p>
        </content>
      </text>
    </region>
    <region left="9" top="6615" width="206" height="56" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">M.1</e>
          <e type="operand">g.k</e>
          <e type="operand">L</e>
          <e type="bracket">(</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">*</e>
          <e type="operand">8</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">kN</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">*</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">/</e>
        </contract>
        <result action="numeric">
          <e type="operand">5.6376</e>
        </result>
      </math>
    </region>
    <region left="270" top="6615" width="192" height="55" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">f.c</e>
          <e type="operand">6</e>
          <e type="operand">M.1</e>
          <e type="operator" args="2">*</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">*</e>
          <e type="operand">b</e>
          <e type="operand">h</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">N</e>
          <e type="operand" style="unit">mm</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">/</e>
        </contract>
        <result action="numeric">
          <e type="operand">5.2852</e>
        </result>
