      <math>
        <input>
          <e type="operand">ε.cd.0</e>
          <e type="operand">0.85</e>
          <e type="operand">220</e>
          <e type="operand">110</e>
          <e type="operand">α.ds1</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">+</e>
          <e type="bracket">(</e>
          <e type="operand">e</e>
