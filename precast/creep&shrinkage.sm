      </math>
    </region>
    <region left="0" top="4293" width="685" height="30" color="#000000" fontSize="10">
      <text lang="eng" width="685" fontFamily="Arial" fontSize="10">
        <content>
          <p>The basic drying shrinkage strain \[REGION[250b2471a7c74aa9991325889050966b]]\ in Table 3.1-5 was calculated in accordance with the following equation:</p>
        </content>
        <regions>
          <region id="250b2471a7c74aa9991325889050966b" left="201" top="0" width="45" height="29" color="#000000" fontSize="10">
            <math>
              <input>
                <e type="operand">ε.cd.0</e>
              </input>
            </math>
          </region>
        </regions>
      </text>
    </region>
