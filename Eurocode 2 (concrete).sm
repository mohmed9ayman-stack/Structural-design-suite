          <e type="operand">S.k.terr</e>
          <e type="operator" args="2">*</e>
          <e type="operand">1</e>
          <e type="operand">G.k.wall</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">+</e>
          <e type="operand">1</e>
          <e type="operand">G.k.terr</e>
