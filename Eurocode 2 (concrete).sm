          <e type="operator" args="2">*</e>
          <e type="operand" style="unit">mm</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">MPa</e>
        </contract>
        <result action="numeric">
          <e type="operand">15.1515</e>
        </result>
      </math>
    </region>
    <region left="279" top="32859" width="90" height="29" color="#000000" bgColor="#00ff00" fontSize="10">
      <math>
        <input>
          <e type="operand">σ</e>
          <e type="operand">σ.2Rd.max</e>
