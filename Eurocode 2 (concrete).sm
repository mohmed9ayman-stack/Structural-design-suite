          <e type="operand">3</e>
          <e type="operand">z</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">/</e>
          <e type="operand">a</e>
          <e type="operator" args="2">*</e>
          <e type="operand">F.Ed</e>
          <e type="operand">3</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">-</e>
