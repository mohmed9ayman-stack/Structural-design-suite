          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">0.0017</e>
        </result>
      </math>
    </region>
    <region left="279" top="34002" width="75" height="51" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">ε.s'</e>
          <e type="operand">f.yd</e>
