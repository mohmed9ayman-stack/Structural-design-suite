          <e type="operator" args="2">*</e>
          <e type="operator" args="2">≥</e>
        </input>
      </math>
    </region>
    <region left="387" top="29817" width="121" height="38" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">K.1</e>
          <e type="operand">A.s</e>
