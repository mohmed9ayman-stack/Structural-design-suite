          <e type="operator" args="2">+</e>
          <e type="operand">1</e>
          <e type="operator" args="2">≤</e>
        </input>
      </math>
    </region>
    <region left="0" top="24165" width="350" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>where TRd,c is the value of the torsion cracking moment:</p>
        </content>
      </text>
    </region>
