    <region left="0" top="46368" width="607" height="23" color="#000000" fontSize="10">
      <text lang="eng" width="607" fontFamily="Arial" fontSize="10">
        <content>
          <p>Working with constant normal force (N = N0 ) the ultimate limit state for the concrete tension leads to</p>
        </content>
      </text>
    </region>
    <region left="0" top="46386" width="583" height="231" color="#000000">
      <picture>
        <raw format="png" encoding="base64"></raw>
      </picture>
    </region>
    <region left="0" top="46620" width="582" height="577" color="#000000">
      <picture>
        <raw format="png" encoding="base64"></raw>
      </picture>
    </region>
    <region left="0" top="47196" width="582" height="459" color="#000000">
